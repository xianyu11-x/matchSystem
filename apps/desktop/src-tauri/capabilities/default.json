{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capability",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/simulator-api",
          "sidecar": true,
          "args": [
            "--addr",
            "127.0.0.1:0"
          ]
        }
      ]
    }
  ]
}
