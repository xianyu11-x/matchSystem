{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matchsystem.local/schema/match-rule/v1",
  "title": "match-rule/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ruleKey",
    "contract",
    "prefilter",
    "evaluation",
    "scoring",
    "seedSelection",
    "runtime"
  ],
  "properties": {
    "schemaVersion": {"const": "match-rule/v1"},
    "ruleKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId"],
      "properties": {
        "namespace": {"$ref": "#/$defs/namespace"},
        "ruleId": {"$ref": "#/$defs/ruleId"}
      }
    },
    "contract": {"$ref": "https://matchsystem.local/schema/logical-node-contract/v3"},
    "prefilter": {"$ref": "https://matchsystem.local/schema/prefilter/v3"},
    "evaluation": {"$ref": "https://matchsystem.local/schema/evaluation/v3"},
    "scoring": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": {"const": "constant"},
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": {"value": {"type": "number"}}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": {"const": "created_at"},
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["direction"],
              "properties": {
                "direction": {"enum": ["ascending", "descending"]},
                "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1.94906280228e289}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": {"const": "int64_field"},
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "direction"],
              "properties": {
                "field": {"type": "string", "minLength": 1},
                "direction": {"enum": ["ascending", "descending"]},
                "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1.94906280228e289},
                "missingScore": {"type": "number"}
              }
            }
          }
        }
      ]
    },
    "seedSelection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": {"const": "arrival"},
            "params": {"type": "object", "additionalProperties": false}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": {"const": "oldest"},
            "params": {"type": "object", "additionalProperties": false}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": {"const": "int64_priority"},
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "direction"],
              "properties": {
                "field": {"type": "string", "minLength": 1},
                "direction": {"enum": ["ascending", "descending"]}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": {"const": "random"},
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["randomSeed"],
              "properties": {"randomSeed": {"type": "integer"}}
            }
          }
        }
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptLimitPerProduceMatch",
        "attemptLimitPerMatchRound",
        "maxPlayers"
      ],
      "properties": {
        "attemptLimitPerProduceMatch": {"type": "integer", "minimum": 1},
        "attemptLimitPerMatchRound": {"type": "integer", "minimum": 1},
        "candidateScoringLimitPerSeed": {"type": "integer", "minimum": 1, "default": 500},
        "candidateLimitPerSeed": {"type": "integer", "minimum": 1, "default": 50},
        "maxPlayers": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "namespace": {
      "description": "Optional free-text alias. Rule identity is determined solely by ruleId.",
      "type": "string"
    },
    "uint64Identity": {
      "description": "Unsigned 64-bit identity as a JSON integer or canonical decimal string without leading zeros.",
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        {"$ref": "#/$defs/uint64Decimal"}
      ]
    },
    "ruleId": {
      "description": "Positive uint64 identity. Input accepts a JSON integer or canonical decimal string without leading zeros.",
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        {"type": "string", "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$(?![\\s\\S])"}
      ]
    },
    "nodeId": {
      "description": "Positive uint64 identity as a JSON integer or canonical decimal string.",
      "$ref": "#/$defs/ruleId"
    },
    "uint64Decimal": {
      "type": "string",
      "anyOf": [
        {"const": "0"},
        {"$ref": "#/$defs/ruleId"}
      ]
    },
    "decimalIdentityPrefix": {
      "description": "Optional decimal prefix. A non-empty prefix is positive and leaves room for at least one Ticket ID digit; the concatenated result must fit uint64.",
      "type": "string",
      "anyOf": [
        {"const": ""},
        {"pattern": "^(?:[1-9][0-9]{0,17}|1[0-7][0-9]{17}|18[0-3][0-9]{16}|184[0-3][0-9]{15}|1844[0-5][0-9]{14}|18446[0-6][0-9]{13}|184467[0-3][0-9]{12}|1844674[0-3][0-9]{11}|184467440[0-6][0-9]{9}|1844674407[0-2][0-9]{8}|18446744073[0-6][0-9]{7}|1844674407370[0-8][0-9]{5}|18446744073709[0-4][0-9]{4}|184467440737095[0-4][0-9]{3}|18446744073709550[0-9]{2}|18446744073709551[0-5][0-9]|1844674407370955160|1844674407370955161)$(?![\\s\\S])"}
      ]
    }
  }
}
