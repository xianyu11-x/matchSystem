{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matchsystem.local/schema/attribute-generators/v1.schema.json",
  "title": "Attribute generators",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/AttributeGenerator"
  },
  "$defs": {
    "AttributeGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "strings",
            "uint64s",
            "int64"
          ]
        },
        "source": {
          "enum": [
            "sample",
            "ticketId",
            "shared"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "set": {
          "type": "string"
        },
        "min": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "max": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "replacement": {
          "type": "boolean",
          "default": false
        },
        "distribution": {
          "enum": [
            "uniform",
            "low",
            "high",
            "triangular",
            "normal"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "mean": {
          "type": "number",
          "description": "Normal mean in min/max; sampled int64 only, safe integer bounds."
        },
        "stdDev": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Normal standard deviation. Round to integer then clamp to min/max."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "distribution"
            ],
            "properties": {
              "distribution": {
                "const": "normal"
              }
            }
          },
          "then": {
            "required": [
              "mean",
              "stdDev",
              "min",
              "max"
            ],
            "properties": {
              "type": {
                "const": "int64"
              },
              "source": {
                "const": "sample"
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "mean"
                  ]
                },
                {
                  "required": [
                    "stdDev"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
