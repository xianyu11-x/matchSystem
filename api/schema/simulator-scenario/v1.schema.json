{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matchsystem.local/schema/simulator-scenario/v1",
  "title": "simulator-scenario/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "physicalNodes", "rules"],
  "properties": {
    "schemaVersion": {"const": "simulator-scenario/v1"},
    "matchHistoryLimit": {"type": "integer", "minimum": 0},
    "routing": {"$ref": "#/$defs/routing"},
    "physicalNodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/physicalNode"}
    },
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["", "weighted_rendezvous", "queue_weighted_random", "weighted_priority"],
          "description": "空值或省略时使用 weighted_rendezvous。"
        },
        "ticketLimit": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"algorithm": {"const": "weighted_priority"}}, "required": ["algorithm"]},
          "then": {"required": ["ticketLimit"], "properties": {"ticketLimit": {"minimum": 1}}}
        }
      ]
    },
    "physicalNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "endpoint", "enabled"],
      "properties": {
        "id": {"$ref": "https://matchsystem.local/schema/match-rule/v1#/$defs/nodeId"},
        "endpoint": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "selector": {"type": "string"},
        "routeUpdateIntervalMs": {
          "type": "integer", "minimum": 0, "maximum": 9223372036854,
          "description": "队列路由快照更新周期（毫秒）；0 或省略时默认 10000。"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalNode", "physicalNodeId", "weight", "enabled", "rule"],
      "properties": {
        "logicalNode": {"$ref": "#/$defs/logicalNode"},
        "physicalNodeId": {"$ref": "https://matchsystem.local/schema/match-rule/v1#/$defs/nodeId"},
        "weight": {"type": "integer", "minimum": 1},
        "enabled": {"type": "boolean"},
        "rule": {"$ref": "https://matchsystem.local/schema/match-rule/v1"},
        "tickFacts": {"$ref": "#/$defs/factSnapshot"},
        "pythonProvider": {"$ref": "#/$defs/pythonProvider"}
      }
    },
    "logicalNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "placementId"],
      "properties": {
        "rule": {"$ref": "#/$defs/ruleKey"},
        "placementId": {"$ref": "https://matchsystem.local/schema/match-rule/v1#/$defs/nodeId"}
      }
    },
    "ruleKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId"],
      "properties": {
        "namespace": {"$ref": "https://matchsystem.local/schema/match-rule/v1#/$defs/namespace"},
        "ruleId": {"$ref": "https://matchsystem.local/schema/match-rule/v1#/$defs/ruleId"}
      }
    },
    "pythonProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script"],
      "properties": {
        "python": {
          "type": "string",
          "description": "Optional server-side Python executable. Omitted or empty selects host discovery."
        },
        "runner": {
          "type": "string",
          "description": "Optional server-side JSON-lines runner path. Omitted or empty selects the built-in runner."
        },
        "script": {
          "type": "string",
          "minLength": 1,
          "description": "Required server-side Python provider script file path."
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "description": "业务 RPC 调用超时，单位毫秒；为 0 或省略时默认 2 秒。启动握手超时取配置值与 2 秒中的较大值。"
        }
      }
    },
    "factSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strings": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        },
        "uint64s": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "integer", "minimum": 0}}
        },
        "int64s": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        }
      }
    }
  }
}
