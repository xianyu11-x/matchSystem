{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matchsystem.local/schema/simulator-scenario/v1",
  "title": "simulator-scenario/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "physicalNodes", "rules"],
  "properties": {
    "schemaVersion": {"const": "simulator-scenario/v1"},
    "matchHistoryLimit": {"type": "integer", "minimum": 0},
    "physicalNodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/physicalNode"}
    },
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "physicalNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "endpoint", "enabled"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "selector": {"type": "string"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalNode", "physicalNodeId", "weight", "enabled", "rule"],
      "properties": {
        "logicalNode": {"$ref": "#/$defs/logicalNode"},
        "physicalNodeId": {"type": "string", "minLength": 1},
        "weight": {"type": "integer", "minimum": 1},
        "enabled": {"type": "boolean"},
        "rule": {"$ref": "../match-rule/v1.schema.json"},
        "tickFacts": {"$ref": "#/$defs/factSnapshot"},
        "factProviderDescriptor": {"$ref": "#/$defs/providerDescriptor"},
        "objectFactProviderDescriptor": {"$ref": "#/$defs/providerDescriptor"},
        "matchFactProviderDescriptor": {"$ref": "#/$defs/providerDescriptor"}
      }
    },
    "logicalNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "placementId"],
      "properties": {
        "rule": {"$ref": "#/$defs/ruleKey"},
        "placementId": {"type": "string", "minLength": 1}
      }
    },
    "ruleKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId"],
      "properties": {
        "namespace": {"type": "string"},
        "ruleId": {"type": "integer", "minimum": 1}
      }
    },
    "providerDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "facts": {
          "type": "array",
          "items": {"$ref": "#/$defs/providerFact"}
        }
      }
    },
    "providerFact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type", "scope", "maxValues"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "type": {"enum": ["strings", "uint64s"]},
            "scope": {"enum": ["tick", "object", "match"]},
            "maxValues": {"type": "integer", "minimum": 1},
            "description": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type", "scope"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "type": {"const": "int64"},
            "scope": {"enum": ["tick", "object", "match"]},
            "description": {"type": "string"}
          }
        }
      ]
    },
    "factSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strings": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        },
        "uint64s": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "integer", "minimum": 0}}
        },
        "int64s": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        }
      }
    }
  }
}
